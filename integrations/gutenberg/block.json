{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "qevora/booking",
	"version": "1.0.0",
	"title": "Qevora Booking",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Show the Qevora appointment booking form.",
	"textdomain": "qevora-booking",
	"attributes": {
		"serviceId": {
			"type": "integer",
			"default": 0
		},
		"staffId": {
			"type": "integer",
			"default": 0
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"showTitle": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "file:./index.js"
}
